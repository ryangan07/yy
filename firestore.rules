rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in ['ganhongkit@gmail.com', 'cari.myproperty@gmail.com'];
    }

    match /enquiries/{id} {
      allow create: if request.resource.data.keys().hasAll(['name', 'phone', 'createdAt'])
                 && request.resource.data.name is string  && request.resource.data.name.size()  <= 100
                 && request.resource.data.phone is string && request.resource.data.phone.size() <= 30
                 && request.resource.data.message is string && request.resource.data.message.size() <= 1000;
      allow read, update, delete: if isAdmin();
    }

    match /posts/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /listings/{id} {
      allow read: if resource.data.published == true || isAdmin();
      allow write: if isAdmin();
    }

    // settings/site holds the homepage photo, which the public homepage must read.
    match /settings/{id} {
      allow read: if id == 'site' || isAdmin();
      allow write: if isAdmin();
    }

    // Anonymous visit counter written by /api/visit (no auth on the server). Only +1 increments of the
    // known fields are accepted, so nobody can rewrite or reset the numbers; only admins can read.
    match /visits/{day} {
      allow read: if isAdmin();
      allow create: if day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
                    && request.resource.data.keys().hasOnly(['views', 'visitors', 'pages', 'updatedAt'])
                    && request.resource.data.views == 1
                    && request.resource.data.visitors <= 1
                    && request.resource.data.pages.size() == 1;
      allow update: if request.resource.data.keys().hasOnly(['views', 'visitors', 'pages', 'updatedAt'])
                    && request.resource.data.views == resource.data.views + 1
                    && request.resource.data.visitors >= resource.data.visitors
                    && request.resource.data.visitors <= resource.data.visitors + 1
                    && request.resource.data.pages.size() <= resource.data.pages.size() + 1
                    && request.resource.data.pages.size() <= 300;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
